<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.alex.whisper-server</string>
<key>ProgramArguments</key><array><string>/opt/homebrew/bin/whisper-server</string><string>-m</string><string>__MODEL_PATH__</string><string>--host</string><string>127.0.0.1</string><string>--port</string><string>8080</string><string>-l</string><string>en</string><string>-t</string><string>4</string><string>-fa</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>__USER_HOME__/Library/Logs/WhisperDictation/server.log</string>
<key>StandardErrorPath</key><string>__USER_HOME__/Library/Logs/WhisperDictation/server-error.log</string>
</dict></plist>
